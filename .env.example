# Copy to .env.local and fill in. Never commit real keys (.env* is git-ignored).
# IGNIS runs with none of these set: pages fall back to local knowledge files.
# `npm run check:env` reports which are usable; `npm run check:db` tests Supabase.
#
# Classes:
#   PUBLIC      sent to every browser. Must be safe to expose.
#   SERVER-ONLY never sent to the browser. Never give these a NEXT_PUBLIC_ name.
#   OPTIONAL    the app is complete without it.

# --- Supabase (Project Settings -> API) ---------------------------------------

# PUBLIC, OPTIONAL. Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# PUBLIC, OPTIONAL. The "anon" / publishable key. Read-only by row-level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY, OPTIONAL. The "service_role" / secret key. Bypasses row-level
# security. Used by ingestion scripts and server code only. In Vercel, add it
# WITHOUT any NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Other ---------------------------------------------------------------------

# SERVER-ONLY, OPTIONAL. Grounded LLM synthesis (not implemented yet).
OPTIONAL_LLM_API_KEY=

# PUBLIC, OPTIONAL, DEVELOPMENT ONLY. Set to 1 to use synthetic TEST data where a
# teammate module is unfinished. Ignored in production builds.
NEXT_PUBLIC_IGNIS_DEV_MOCKS=
