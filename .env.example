# Copy to .env.local and fill in. Never commit real keys.
# The app runs without any of these; pages fall back to local knowledge files.

# Supabase project (Project Settings -> API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row-level security. Used by ingestion scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Development only. Set to 1 to use synthetic TEST data where a teammate module
# is not finished (currently: evidence search). Ignored in production builds.
NEXT_PUBLIC_IGNIS_DEV_MOCKS=

# Optional. Only for grounded LLM synthesis, which is not implemented yet.
OPTIONAL_LLM_API_KEY=
